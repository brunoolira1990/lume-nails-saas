# Copie para supabase/functions/.env (ignorado pelo git) para testes locais.
# Em produção use: npx supabase secrets set CHAVE=valor

# Token exibido na configuração do webhook da Hotmart.
HOTMART_HOTTOK=seu_hottok_aqui

# Opcional: URL para onde o link do e-mail de convite/recuperação redireciona.
APP_URL=https://app.seudominio.com.br

# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetados automaticamente
# pelo Supabase em produção e pelo `supabase functions serve` localmente.
